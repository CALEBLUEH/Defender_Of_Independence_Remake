  m_Script: {fileID: 11500000, guid: b21e7b6489f2c284e9a810964a23e409, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DefenderOfIndependence.Level2.LevelTwoDocumentLocation
  room: 0
  interactionCollider: {fileID: 2121312135}
  pages:
  - title: Level 2 Instructions
    body: "You have five days to prepare for the final conference.\n\nEach major
      activity costs 1 Energy. You begin every day with 4 Energy. The first entry
      into each room during a day costs 1 Energy; after paying once, you may leave
      and re-enter that room freely until the next day.\n\nYour decisions affect:\nBritish
      Confidence\nDelegation Unity\nPublic Support\n\nRead documents before important
      conversations to strengthen related positive outcomes. Conversations cost 1
      Energy and can only be completed once.\n\nCONTROLS\nW A S D \u2013 Move around
      the conference building\nMOUSE \u2013 Look around; use the pointer in documents
      and conversations\nC \u2013 Enter or leave a room, examine a document, or begin
      a conversation\nMOUSE WHEEL / SCROLLBAR \u2013 Scroll an open document\nX /
      C / ESC \u2013 Close an open document\n\nUse the clock in the Main Lobby when
      you are ready to end the day and restore your Energy."
  reusable: 1
  energyCost: 0
