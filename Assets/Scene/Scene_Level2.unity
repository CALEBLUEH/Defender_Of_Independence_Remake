  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b21e7b6489f2c284e9a810964a23e409, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DefenderOfIndependence.Level2.LevelTwoDocumentLocation
  room: 3
  interactionCollider: {fileID: 52085941}
  pages:
  - title: The Alliance
    body: "Malaya's independence movement depended not only on negotiation with Britain
      but also on cooperation within Malaya.\n\nThe Alliance brought together three
      major political organizations:\n\u2022 UMNO \u2013 United Malays National Organization\n\u2022
      MCA \u2013 Malayan Chinese Association\n\u2022 MIC \u2013 Malayan Indian Congress\n\nCooperation
      between different communities strengthened the claim that Malaya could establish
      a representative government."
  - title: Persuasion Instead of Confrontation
    body: 'Malaya''s struggle for independence did not depend on only one kind of
      political action.


      Political leaders organised parties, elections, public
      meetings and negotiations to build support for self-government.


      For
      the delegation, maintaining public support for a peaceful constitutional route
      is important. Violent confrontation could weaken both unity at home and confidence
      during negotiations abroad.'
  - title: The Formation of Malaysia
    body: 'Independence in 1957 concerned the Federation of Malaya.


      Malaysia
      was formed later.


      On 16 September 1963, the Federation of Malaya, Sabah,
      Sarawak and Singapore formed Malaysia.


      Singapore later separated from
      Malaysia on 9 August 1965.'
  reusable: 0
  energyCost: 1
  meterController: {fileID: 1076581259}
  documentBonusMeter: 3
  documentBonusAmount: 5
